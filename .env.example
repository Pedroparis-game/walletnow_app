# WalletNow Environment Configuration
# ==================================
# Este arquivo serve como template (contrato).
# Copie-o para `.env.local` (ambiente local) ou `.env-dev`/`.env-homolog`/`.env-prod`
# dependendo da estratégia de build e configure os valores adequadamente.

# ─── Soroswap Plugin ─────────────────────────────────────────────────────
# Obtenha uma chave em: https://api.soroswap.finance/login
VITE_SOROSWAP_API_KEY="sk_sua_api_key_aqui"

# 'testnet' ou 'mainnet'
VITE_SOROSWAP_NETWORK="testnet"

# Opcional, default: https://api.soroswap.finance
VITE_SOROSWAP_API_BASE_URL="https://api.soroswap.finance"

# ─── Defindex Plugin ──────────────────────────────────────────────────────
# Registre-se em: https://api.defindex.io e gere sua API key no dashboard.
# (Login → API Keys → Generate)
VITE_DEFINDEX_API_KEY="sk_sua_api_key_defindex_aqui"

# 'testnet' ou 'mainnet'
VITE_DEFINDEX_NETWORK="testnet"

# Opcional, default: https://api.defindex.io
VITE_DEFINDEX_API_BASE_URL="https://api.defindex.io"

# ─── WalletNow Core ──────────────────────────────────────────────────────
# Especifique outras variáveis de sistema / núcleo se houver
# VITE_DEFAULT_NETWORK="testnet"

