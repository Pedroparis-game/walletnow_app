# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Auth
VITE_SUPABASE_URL=sua_url_do_projeto_supabase_aqui
VITE_SUPABASE_ANON_KEY=sua_chave_anon_do_supabase_aqui

# Integrações Biometria / Inteligência
VITE_GEMINI_API_KEY=sua_chave_gemini_aqui

# Blockchain — Issuer Wallet (Apenas para assets BRW/mock internos)
# STELLAR_ISSUER_SECRET foi movido para a Supabase Edge Function `stellar-issuer`
# e configurado no Supabase Vault em produção.
VITE_STELLAR_ISSUER_PUBLIC=GCHRUILBTJGG5RNCPP65J5BRJXYACKAKMX5IJRAAN5VXW52LKGXILQTM

# Blockchain — Treasury Wallet (Hot Wallet operacional para SRT)
# SEPARADA do issuer. Responsabilidade: holding e distribuição de SRT (Stellar TestAnchor).
# Setup obrigatório: gere keypair → Friendbot XLM → trustline SRT → receba SRT via TestAnchor.
# SRT Issuer Testnet: GCDNJUBQSX7AJWLJACMJ7I4BC3Z47BQUTMHEICZLE6MU4KQBRYG5JY6B
# Referência: https://testanchor.stellar.org/.well-known/stellar.toml
VITE_STELLAR_TREASURY_SECRET=sua_treasury_secret_key_para_srt_aqui

# Integrações On-Ramp/Off-Ramp fiduciárias
VITE_WOOVI_APP_ID=seu_app_id_base64_da_woovi_aqui

# Stellar Network
# TESTNET (default/dev): usar 'testnet'
# MAINNET (producao): NÃO definir esta variavel — o toggle dinamico via NetworkContext
# controla a rede em runtime usando localStorage (@walletnow:runtime-network).
# O AppConfig.stellar.isMainnet e ESTATICO; o toggle e DINAMICO.
VITE_STELLAR_NETWORK=testnet

# Mainnet Treasury (apenas Supabase Vault — NUNCA no bundle!)
# A secret MAINNET_TREASURY_SECRET deve ser configurada exclusivamente via:
# supabase secrets set MAINNET_TREASURY_SECRET=<secret>
# OU via Supabase Dashboard > Edge Functions > Secrets.
# NUNCA adicionar em VITE_* ou no .env.local de producao.
# MAINNET_TREASURY_SECRET=NAO_COLOCAR_AQUI_USE_SUPABASE_VAULT
