{
  "name": "@walletnow/crypto",
  "version": "0.1.0-alpha",
  "description": "WalletNow OS — Cryptographic operations (key derivation, signing, encryption, hashing) for Stellar",
  "keywords": ["stellar", "crypto", "ed25519", "aes-gcm", "pbkdf2", "bip39", "web-crypto", "walletnow"],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@walletnow/contracts": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
