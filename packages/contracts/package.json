{
  "name": "@walletnow/contracts",
  "version": "0.1.0-alpha",
  "description": "WalletNow OS — Canonical contracts (interfaces, types, errors). The single source of truth. Zero runtime dependencies.",
  "keywords": ["stellar", "contracts", "interfaces", "types", "walletnow"],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
