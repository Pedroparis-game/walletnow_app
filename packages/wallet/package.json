{
  "name": "@walletnow/wallet",
  "version": "0.1.0-alpha",
  "description": "WalletNow OS — Wallet Engine (Key Management) & Account Engine (On-Chain State)",
  "keywords": ["stellar", "wallet", "account", "walletnow"],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@walletnow/contracts": "workspace:*",
    "@walletnow/storage": "workspace:*",
    "@walletnow/crypto": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
