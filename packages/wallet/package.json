{
  "name": "@walletnow/wallet",
  "version": "0.1.1",
  "description": "WalletNow OS — Wallet Engine (Key Management) & Account Engine (On-Chain State)",
  "keywords": [
    "stellar",
    "wallet",
    "account",
    "walletnow"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@walletnow/contracts": "*",
    "@walletnow/storage": "*",
    "@walletnow/crypto": "*",
    "@stellar/stellar-sdk": "^12.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
