{
  "name": "@walletnow/sdk",
  "version": "0.1.2",
  "description": "WalletNow SDK — The simplest way to put users inside Stellar",
  "keywords": [
    "stellar",
    "sdk",
    "walletnow",
    "onboarding",
    "infrastructure"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./testnetkit": {
      "types": "./dist/testnetkit.d.ts",
      "import": "./dist/testnetkit.js",
      "require": "./dist/testnetkit.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^12.0.0",
    "@walletnow/contracts": "*",
    "@walletnow/onboarding": "*",
    "@walletnow/providers": "*"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "lucide-react": ">=0.200.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  }
}
