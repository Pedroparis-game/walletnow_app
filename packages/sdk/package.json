{
  "name": "@walletnow/sdk",
  "version": "0.1.0-alpha",
  "description": "WalletNow OS — Unified SDK for Stellar builders. Identity, Wallet, Providers, Protocols and Testnet infrastructure in one package.",
  "keywords": [
    "stellar", "sdk", "wallet", "passkeys", "identity", "defi",
    "soroban", "horizon", "usdc", "brz", "faucet", "testnet",
    "soroswap", "defindex", "etherfuse", "web3", "blockchain"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@walletnow/core": "workspace:*",
    "@walletnow/identity": "workspace:*",
    "@walletnow/wallet": "workspace:*",
    "@walletnow/providers": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
