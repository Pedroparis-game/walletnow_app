{
  "name": "@walletnow/identity",
  "version": "0.1.0-alpha",
  "description": "WalletNow OS — Identity Engine (Passkeys, OAuth, Keypair Auth)",
  "keywords": ["stellar", "identity", "auth", "passkeys", "walletnow"],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@walletnow/contracts": "*",
    "@walletnow/storage": "*",
    "@walletnow/crypto": "*",
    "@stellar/stellar-sdk": "^12.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
