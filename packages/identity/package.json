{
  "name": "@walletnow/identity",
  "version": "0.1.0-alpha",
  "description": "WalletNow OS — Identity Engine (FIDO2/Passkey, WebAuthn, Social Logins, Session)",
  "keywords": ["stellar", "passkeys", "webauthn", "fido2", "identity", "web3"],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@walletnow/core": "workspace:*"
  },
  "devDependencies": {
    "@walletnow/core": "workspace:*",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
